{
  "name": "modavista",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ssr": "cross-env NEXT_DISABLE_STATICGEN=true next build",
    "build:render": "prisma generate && next build",
    "build:production": "NODE_ENV=production prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:pull": "prisma db pull --force",
    "db:studio": "prisma studio",
    "keep-alive": "node scripts/keep-alive.js",
    "postinstall": "prisma generate",
    "predeploy": "cross-env NEXT_OUTPUT_MODE=export next build",
    "deploy": "gh-pages -d out"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.91.0",
    "autoprefixer": "^10.4.23",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.14",
    "dotenv": "^17.2.3",
    "formidable": "^3.5.4",
    "framer-motion": "^12.28.1",
    "isomorphic-dompurify": "^2.35.0",
    "jsdom": "^27.4.0",
    "mime-types": "^3.0.2",
    "next": "^16.3.1",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.17.2",
    "postcss": "^8.5.26",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-toastify": "^11.0.5",
    "swr": "^2.3.8",
    "tailwindcss": "^3.4.19",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.7",
    "gh-pages": "^6.3.0",
    "prisma": "^5.22.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "ajv@<6.14.0": ">=6.14.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "brace-expansion": ">=5.0.9",
      "picomatch": ">=4.0.4",
      "follow-redirects": ">=1.16.0",
      "uuid": ">=14.0.0",
      "axios": ">=1.19.0",
      "dompurify": ">=3.4.14",
      "postcss": ">=8.5.26",
      "next": ">=16.3.1",
      "next-auth": ">=4.24.15",
      "nodemailer": ">=9.0.5",
      "sharp": ">=0.35.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "nanoid@<3.3.18": ">=3.3.18",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "@babel/core@<7.29.6": ">=7.29.6"
    }
  }
}